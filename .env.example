# Node 24.14+; copy this file to .env
HOST=127.0.0.1
PORT=3101
APP_ORIGIN=http://127.0.0.1:3101
DATABASE_PATH=./data/marketing101.db
# Set true only with HTTPS. Production requires HTTPS and a configured origin.
COOKIE_SECURE=false
NODE_ENV=development
# An optional invite code restricts registration. Production requires one.
REGISTRATION_CODE=
WORKER_INTERVAL_MS=2000
